# Socket.io server URL
# This file is the default fallback

# Priority order:
# 1. .env.local (local development) - uses localhost
# 2. .env (this file) - fallback
# 3. eas.json env (EAS builds) - uses Render URL

# Default to localhost for development
EXPO_PUBLIC_SERVER_URL=http://192.168.1.6:3001
